{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rc-architecture",
  "keep_vars": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "images": { "binding": "IMAGES" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "rc-architecture" }],
  "vars": {
    "CHISEL_ENABLED": "1",
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "dlbl0h64",
    "NEXT_PUBLIC_SANITY_DATASET": "production"
  },
  "env": {
    "staging": {
      "name": "rc-architecture-staging",
      "workers_dev": true,
      "images": { "binding": "IMAGES" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "rc-architecture-staging" }],
      "kv_namespaces": [],
      "vars": {
        "RC_STAGING": "1",
        "CHISEL_ENABLED": "1",
        "NEXT_PUBLIC_SANITY_PROJECT_ID": "dlbl0h64",
        "NEXT_PUBLIC_SANITY_DATASET": "production"
      }
    }
  }
}
