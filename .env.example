# Public Sanity read configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Form delivery through the Resend HTTP API
RESEND_API_KEY=
CONTACT_FROM_EMAIL=RC Architecture <website@example.com>
CONTACT_TO_EMAIL=info@example.com

# Sanity webhook authorization: Authorization: Bearer <secret>
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=
SANITY_API_READ_TOKEN=

# Optional browser telemetry. Public flags are frozen at build time.
NEXT_PUBLIC_ENABLE_WEB_VITALS=false
NEXT_PUBLIC_ENABLE_TELEMETRY=false
ANALYTICS_ENDPOINT=
ANALYTICS_TOKEN=
MONITORING_ENDPOINT=
MONITORING_TOKEN=
